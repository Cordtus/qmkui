# QMKUI HID access for supported Keychron devices.
# Grants the input group access to the raw HID interfaces QMKUI uses. Reads are
# always allowed; writes are gated behind explicit operator confirmation in the
# app and only emit allow-listed VIA frames.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="3434", ATTRS{idProduct}=="0950", MODE="0660", GROUP="input"
